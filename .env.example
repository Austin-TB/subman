# Postgres (local)
DATABASE_URL="postgresql://subman:subman@localhost:5432/subman"

# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET="change-me"
BETTER_AUTH_URL="http://localhost:3000"

# Business settings
APP_TZ="Asia/Kolkata"
NEXT_PUBLIC_CURRENCY="INR"
NEXT_PUBLIC_LOCALE="en-IN"
COMPANY_NAME="Brightloop"

# SMTP (optional). Without it, emails are only saved to the in-app Outbox.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Brightloop Billing <billing@brightloop.example>"
